  m_Script: {fileID: 11500000, guid: 74ed090522987864b928161a5d8c2d7c, type: 3}
  m_Name: MemoData
  m_EditorClassIdentifier: Assembly-CSharp::Bak.UI.MemoData
  pages:
  - tab: "\u041F\u041E\u0420\u042F\u0414\u041E\u041A"
    title: "\u041F\u041E\u0420\u042F\u0414\u041E\u041A \u041F\u0420\u0418\u0401\u041C\u0410 \u0412\u042B\u0417\u041E\u0412\u0410"
    subtitle: "\u043E\u0431\u0449\u0438\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F"
    blocks:
    - heading: "\u042D\u0422\u0410\u041F\u042B"
      items:
      - "\u0412\u044B\u044F\u0441\u043D\u0438\u0442\u044C: \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0433\u0434\u0435, \u043A\u0442\u043E \u0440\u044F\u0434\u043E\u043C."
      - "\u0421\u0432\u0435\u0440\u0438\u0442\u044C \u0441\u043B\u043E\u0432\u0430 \u0430\u0431\u043E\u043D\u0435\u043D\u0442\u0430 \u0441 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432."
      - "\u0423\u0442\u043E\u0447\u043D\u0438\u0442\u044C. \u0412\u0435\u0436\u043B\u0438\u0432\u043E \u0438 \u043F\u043E \u0434\u0435\u043B\u0443."
      - "\u041D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043E\u0434\u043D\u0443 \u0441\u043B\u0443\u0436\u0431\u0443. \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435."
    - heading: "\u041F\u041E\u041C\u041D\u0418\u0422\u042C"
      items:
      - "\u0412\u044B\u0435\u0437\u0434 \u043B\u0438\u043A\u0432\u0438\u0434\u0430\u0442\u043E\u0440\u043E\u0432 \u2014 40 000 \u0440\u0443\u0431."
      - "\u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0430\u0431\u043E\u043D\u0435\u043D\u0442\u0430 \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E."
    decision: "\u0421\u041E\u041C\u041D\u0415\u041D\u0418\u042F \u2014 \u0412 \u041F\u041E\u041B\u042C\u0417\u0423 \u0420\u0415\u0413\u041B\u0410\u041C\u0415\u041D\u0422\u0410"
  - tab: "\u041B\u041E\u0416\u041D\u042B\u0415"
    title: "\u041B\u041E\u0416\u041D\u042B\u0415 \u0412\u042B\u0417\u041E\u0412\u042B"
    subtitle: "\u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0438, \u043F\u0430\u043D\u0438\u043A\u0430, \u0431\u044B\u0442\u043E\u0432\u043E\u0435"
    blocks:
    - heading: "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418"
      items:
      - "\u041F\u0443\u0442\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u0445, \u043C\u0435\u043D\u044F\u0435\u0442 \u0434\u0435\u0442\u0430\u043B\u0438."
      - "\xAB\u041F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u044B\xBB, \xAB\u043C\u043E\u043D\u0441\u0442\u0440 \u043F\u043E\u0434 \u043A\u0440\u043E\u0432\u0430\u0442\u044C\u044E\xBB."
      - "\u0421\u043C\u0435\u0445 \u0438 \u0433\u043E\u043B\u043E\u0441\u0430 \u043D\u0430 \u0444\u043E\u043D\u0435, \u043E\u0442\u0432\u0435\u0442\u044B \u043D\u0435\u0432\u043F\u043E\u043F\u0430\u0434."
    - heading: "\u0423\u0422\u041E\u0427\u041D\u0418\u0422\u042C"
      items:
      - "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E."
      - "\u041A\u0442\u043E \u0435\u0449\u0451 \u044D\u0442\u043E \u0432\u0438\u0434\u0435\u043B?"
    decision: "\u0418\u0413\u041D\u041E\u0420\u0418\u0420\u041E\u0412\u0410\u0422\u042C \xB7 \u041F\u0420\u0418 \u041F\u0421\u0418\u0425\u041E\u0417\u0415 \u2014 \u0421\u041A\u041E\u0420\u0410\u042F"
  - tab: "\u0420\u0410\u0411\u041E\u0427\u0418\u0419"
    title: "\u041E\u0411\u0420\u0410\u0417\u0415\u0426 \xAB\u0420\u0410\u0411\u041E\u0427\u0418\u0419\xBB"
    subtitle: "\u0440\u0430\u0437\u0433.: \xAB\u043C\u0443\u0442\u0430\u0446\u0438\u044F\xBB"
    blocks:
    - heading: "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418"
      items:
      - "\u0428\u0443\u043C \u0440\u0430\u0437\u0431\u043E\u0440\u043A\u0438 \u043C\u0435\u0431\u0435\u043B\u0438 \u0438 \u043F\u043E\u043B\u043E\u0432 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u0430."
      - "\u0420\u044B\u0447\u0430\u043D\u0438\u0435, \xAB\u0432\u043B\u0430\u0436\u043D\u044B\u0435\xBB \u0437\u0432\u0443\u043A\u0438."
      - "\u0421\u044B\u0440\u043E\u0441\u0442\u044C, \u0440\u0436\u0430\u0432\u044B\u0439 \u043D\u0430\u043B\u0451\u0442 (\xAB\u043F\u043B\u0435\u0441\u0435\u043D\u044C\xBB) \u0443 \u0442\u0440\u0443\u0431 \u0438 \u0441\u0442\u043E\u044F\u043A\u043E\u0432."
      - "\u0416\u0438\u043B\u044C\u0446\u044B \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0438 \u043D\u0435 \u043E\u0442\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0438\u043C\u0435\u043D\u0438."
    - heading: "\u0423\u0422\u041E\u0427\u041D\u0418\u0422\u042C"
      items:
      - "\u0427\u0435\u043C \u043F\u0430\u0445\u043D\u0435\u0442 \u0438\u0437-\u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u0438?"
      - "\u0415\u0441\u0442\u044C \u043B\u0438 \u0440\u044B\u0436\u0438\u0439 \u043D\u0430\u043B\u0451\u0442 \u0432 \u0432\u0430\u043D\u043D\u043E\u0439, \u043D\u0430 \u0442\u0440\u0443\u0431\u0430\u0445?"
      - "\u041A\u043E\u0433\u0434\u0430 \u0441\u043E\u0441\u0435\u0434\u0435\u0439 \u0432\u0438\u0434\u0435\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437?"
    decision: "\u041B\u0418\u041A\u0412\u0418\u0414\u0410\u0422\u041E\u0420\u042B \xB7 \u041C\u0418\u041B\u0418\u0426\u0418\u042E \u041D\u0415 \u041D\u0410\u041F\u0420\u0410\u0412\u041B\u042F\u0422\u042C"
  - tab: "\u0421\u0422\u041E\u0420\u041E\u0416"
    title: "\u041E\u0411\u0420\u0410\u0417\u0415\u0426 \xAB\u0421\u0422\u041E\u0420\u041E\u0416\xBB"
    subtitle: "\u0440\u0430\u0437\u0433.: \xAB\u0438\u043C\u0438\u0442\u0430\u0442\u043E\u0440\xBB"
    blocks:
    - heading: "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418"
      items:
      - "\u0414\u043E\u043C\u0430\u0448\u043D\u0435\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044F \xAB\u043D\u0435 \u0442\u0430\u043A\xBB."
      - "\u0420\u044B\u0447\u0430\u043D\u0438\u0435 \u0441\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0442\u0438\u0448\u0438\u043D\u043E\u0439 \u0438 \u0441\u043A\u0443\u043B\u0435\u0436\u043E\u043C."
      - "\u041F\u043E\u0434\u0440\u0430\u0436\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0441\u0443 \u0438\u043B\u0438 \u0441\u043B\u043E\u0432\u0430\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
    - heading: "\u0423\u0422\u041E\u0427\u041D\u0418\u0422\u042C"
      items:
      - "\u0413\u0434\u0435 \u0432\u044B \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E?"
      - "\u041F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u043B\u0438 \u043E\u043D\u043E \u0441\u043B\u043E\u0432\u0430?"
    decision: "\u041B\u0418\u041A\u0412\u0418\u0414\u0410\u0422\u041E\u0420\u042B \xB7 \u041D\u0415\u041C\u0415\u0414\u041B\u0415\u041D\u041D\u041E"
  - tab: "\u0414\u0423\u0411\u041B\u0401\u0420"
    title: "\u041E\u0411\u0420\u0410\u0417\u0415\u0426 \xAB\u0414\u0423\u0411\u041B\u0401\u0420\xBB"
    subtitle: "\u0440\u0430\u0437\u0433.: \xAB\u0434\u043E\u043F\u043F\u0435\u043B\u044C\u0433\u0430\u043D\u0433\u0435\u0440\xBB"
    blocks:
    - heading: "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418"
      items:
      - "\u0411\u043B\u0438\u0437\u043A\u0438\u0439 \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044F \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
      - "\u0413\u043E\u0442\u043E\u0432\u044B\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u043B\u044E\u0431\u044B\u043C \u043D\u0435\u0441\u043E\u0441\u0442\u044B\u043A\u043E\u0432\u043A\u0430\u043C."
      - "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \xAB\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F\xBB \u0432 \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u0442\u0430\u0445 \u0441\u0440\u0430\u0437\u0443."
    - heading: "\u0423\u0422\u041E\u0427\u041D\u0418\u0422\u042C"
      items:
      - "\u0413\u0434\u0435 \u0435\u0433\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D? \u041A\u0442\u043E \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435?"
      - "\u041C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u043F\u0435\u0440\u0435\u0442\u044C\u0441\u044F \u0438 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C?"
    decision: "\u041B\u0418\u041A\u0412\u0418\u0414\u0410\u0422\u041E\u0420\u042B \xB7 \u0410\u0411\u041E\u041D\u0415\u041D\u0422\u0423 \u041D\u0415 \u0412\u042B\u0425\u041E\u0414\u0418\u0422\u042C"
