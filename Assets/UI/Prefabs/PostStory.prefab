  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u043E\u0447\u044C\u044E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B \u0411\u044E\u0440\u043E \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0434\u043E\u043C \u2116 14 \u043F\u043E \u0417\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u0439 \u0443\u043B\u0438\u0446\u0435 \u043E\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0439 \u043F\u043B\u0435\u0441\u0435\u043D\u0438, \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0439 \u0432 \u0441\u0442\u043E\u044F\u043A\u0430\u0445. \u041F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u0411\u044E\u0440\u043E, \u0443\u0433\u0440\u043E\u0437\u044B \u0434\u043B\u044F \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0434\u043E\u043C\u043E\u0432 \u043D\u0435\u0442.\n\n\u0416\u0438\u043B\u044C\u0446\u043E\u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B \u2116 37 \u0443\u0432\u0435\u0437\u043B\u0438 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443 \u0441 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C. \u0421\u043E\u0441\u0435\u0434, \u0432\u044B\u0437\u0432\u0430\u0432\u0448\u0438\u0439 \u0441\u043B\u0443\u0436\u0431\u0443, \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D \u0448\u0443\u043C\u043E\u043C \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0431\u043E\u0442."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9f1cf4de86cfcc44385779370475508f, type: 2}
